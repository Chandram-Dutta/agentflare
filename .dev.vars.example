# Copy to .dev.vars (ignored). Never commit live values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user IDs, not usernames. No wildcard access.
ALLOWED_GITHUB_IDS=
# GitHub App repository access. Keep the multiline PEM quoted or upload as a Worker secret.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional durable Codex workspaces. See README before enabling locally.
# Use a separate private development bucket, never the production bucket.
BACKUP_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
