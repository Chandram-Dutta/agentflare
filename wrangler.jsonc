{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentflare-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "none" },
  "containers": [
    {
      "class_name": "ThreadSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandboxes", "class_name": "ThreadSandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadSandbox"] }],
  // Create this private bucket before deployment; do not add expiration rules.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "agentflare-workspaces" }
  ],
  "vars": { "BACKUP_BUCKET_NAME": "agentflare-workspaces" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentflare",
      // Local-only placeholder. Replace with your own D1 ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "next": {
      "name": "agentflare-next",
      "workers_dev": false,
      "preview_urls": false,
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ThreadSandbox"] },
        {
          "tag": "v2-computer",
          "new_sqlite_classes": ["ComputerThread", "ComputerCredentials"]
        },
        {
          "tag": "v3-native-runtime",
          "new_sqlite_classes": ["NativeThread"],
          "deleted_classes": ["ComputerThread"]
        }
      ],
      "containers": [
        {
          "class_name": "ThreadSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 2
        },
        {
          "class_name": "NativeThread",
          "scheduling_policy": "durable_object",
          "images": {
            "workspace": {
              "dockerfile": "./sandbox/Computer.Dockerfile",
              "build_context": "."
            }
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "Sandboxes", "class_name": "ThreadSandbox" },
          { "name": "Computers", "class_name": "NativeThread" },
          { "name": "ComputerAuth", "class_name": "ComputerCredentials" }
        ]
      },
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "agentflare-next" }],
      "routes": [
        { "pattern": "agentflare-next.onlychan.xyz", "custom_domain": true }
      ],
      "vars": {
        "BACKUP_BUCKET_NAME": "agentflare-next-workspaces",
        "BETTER_AUTH_URL": "https://agentflare-next.onlychan.xyz",
        "GITHUB_CLIENT_ID": "Iv23liBzGNYd1ZpDKH0e",
        "GITHUB_APP_ID": "5124431",
        "ALLOWED_GITHUB_IDS": "81961406"
      },
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "agentflare-next-workspaces"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentflare-next",
          "database_id": "d9c974b1-e491-411a-a228-1b44fbccecbe",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "agentflare-web",
      "workers_dev": false,
      "preview_urls": false,
      "containers": [
        {
          "class_name": "ThreadSandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "Sandboxes", "class_name": "ThreadSandbox" }]
      },
      "routes": [
        { "pattern": "agentflare.onlychan.xyz", "custom_domain": true }
      ],
      "vars": {
        "BACKUP_BUCKET_NAME": "agentflare-workspaces",
        "BETTER_AUTH_URL": "https://agentflare.onlychan.xyz",
        "GITHUB_CLIENT_ID": "Iv23liBzGNYd1ZpDKH0e",
        "GITHUB_APP_ID": "5124431",
        "ALLOWED_GITHUB_IDS": "81961406"
      },
      "r2_buckets": [
        { "binding": "BACKUP_BUCKET", "bucket_name": "agentflare-workspaces" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentflare",
          "database_id": "6f9aeb28-b4e7-416c-ad86-785d5363ca05",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "observability": { "enabled": true }
}
